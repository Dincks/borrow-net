#!/usr/bin/env bash
set -euo pipefail

VERSION="4.5.0"
SCRIPT_NAME="$(basename "$0")"

MODE="${1:-menu}"
TARGET="${BORROW_NET_TARGET:-}"
SSH_USER="${BORROW_NET_USER:-}"
SSH_PORT="${BORROW_NET_SSH_PORT:-22}"
TEST_URL="${BORROW_NET_TEST_URL:-https://api.ipify.org}"
EXTRA_TEST_URLS="${BORROW_NET_EXTRA_TEST_URLS:-https://github.com https://raw.githubusercontent.com}"
TRIES="${BORROW_NET_TRIES:-2}"
SLEEP_SECS="${BORROW_NET_SLEEP:-1}"

PROXY_URL_MANUAL="${BORROW_NET_PROXY_URL:-}"
PROXY_PORT_MANUAL="${BORROW_NET_PROXY_PORT:-}"
PROXY_SCHEME_MANUAL="${BORROW_NET_PROXY_SCHEME:-http}"
LOCAL_IP_OVERRIDE="${BORROW_NET_LOCAL_IP:-}"
APT_MODE="${BORROW_NET_APT_MODE:-ask}"  # ask | yes | no
APT_HANDLED="no"
SYNC_TIME_MODE="${BORROW_NET_SYNC_TIME:-no}"  # auto | yes | no

LOCAL_IP=""
SEL_SCHEME=""
SEL_LOCAL_URL=""
SEL_REMOTE_URL=""
SEL_SOURCE=""

CANDIDATES=()

SSH_CONTROL_DIR=""
SSH_CONTROL_PATH=""
SSH_MASTER_STARTED="no"
SUDO_PRIMED="no"
SUDO_PASSWORD=""
AUTH_PASSWORD=""
AUTH_PASSWORD_CAPTURED="no"
ASKPASS_DIR=""
ENABLE_ROLLBACK_ARMED="no"

usage() {
  cat <<EOF
borrow-net v${VERSION}

用法：
  ${SCRIPT_NAME}
  ${SCRIPT_NAME} enable <目标IP> -u <用户名> [选项]
  ${SCRIPT_NAME} clear  <目标IP> -u <用户名> [选项]

示例：
  ${SCRIPT_NAME} enable 192.168.1.2 -u sunrise --with-apt
  ${SCRIPT_NAME} clear  192.168.1.2 -u sunrise --with-apt

选项：
  -u, --user <user>          目标主机 SSH 用户名
  -P, --ssh-port <port>      目标主机 SSH 端口，默认 22
  --proxy-url <url>          覆盖自动检测结果，手动指定本机代理
  -p, --proxy-port <port>    覆盖自动检测结果，手动指定本机代理端口
  --proxy-scheme <scheme>    http / socks5h，默认 http
  -l, --local-ip <ip>        手动指定目标主机访问本机所使用的 IP
  --with-apt                 同时配置 / 清除 APT 系统级代理
  --no-apt                   不配置 / 不清除 APT 系统级代理
  --sync-time                配置代理前同步目标主机时间
  --no-sync-time             不同步目标主机时间（默认）
  -h, --help                 显示帮助

说明：
  - 若 SSH 已配置公钥/Agent 免密认证，仅需输入一次 sudo 密码。
  - 若 SSH 需要密码，脚本仅询问一次，并将同一密码用于后续 sudo 认证；因此 SSH 与 sudo 密码需保持一致。
  - 执行 enable 后会部署一次性的 systemd 生命周期清理：正常关机/重启时恢复原配置并移除 borrow-net 组件。
  - 若发生异常断电，残留状态会在下一次启动时恢复，随后同样移除 borrow-net 组件。
EOF
}

log() { printf '[INFO] %s\n' "$*"; }
step() { printf '\n===== %s =====\n' "$*"; }
ok() { printf '[ OK ] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
die() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

need() {
  command -v "$1" >/dev/null 2>&1 || die "缺少必要的系统命令：$1"
}

has_tty() {
  [ -r /dev/tty ] && [ -w /dev/tty ]
}

read_tty() {
  local prompt="$1" default="${2:-}" ans
  if has_tty; then
    if [ -n "$default" ]; then
      printf '%s [%s]: ' "$prompt" "$default" >/dev/tty
    else
      printf '%s: ' "$prompt" >/dev/tty
    fi
    IFS= read -r ans </dev/tty || ans=""
    printf '%s\n' "${ans:-$default}"
  else
    printf '%s\n' "$default"
  fi
}

read_required_tty() {
  local prompt="$1" ans
  has_tty || die "当前会话无可用交互终端，请使用命令行参数指定 ${prompt}。"
  while true; do
    printf '%s: ' "$prompt" >/dev/tty
    IFS= read -r ans </dev/tty || ans=""
    if [ -n "$ans" ]; then
      printf '%s\n' "$ans"
      return 0
    fi
    printf '[ERROR] %s不能为空。\n' "$prompt" >/dev/tty
  done
}

read_optional_tty() {
  local prompt="$1" hint="$2" ans
  if has_tty; then
    printf '%s [%s]: ' "$prompt" "$hint" >/dev/tty
    IFS= read -r ans </dev/tty || ans=""
    printf '%s\n' "$ans"
  else
    printf '\n'
  fi
}

ask_yes_no() {
  local prompt="$1" default="${2:-N}" ans mark
  mark="[y/N]"
  [[ "$default" =~ ^[Yy]$ ]] && mark="[Y/n]"
  if has_tty; then
    printf '%s %s: ' "$prompt" "$mark" >/dev/tty
    IFS= read -r ans </dev/tty || ans=""
  else
    ans="$default"
  fi
  ans="${ans:-$default}"
  case "$ans" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

ssh_target() {
  printf '%s@%s' "$SSH_USER" "$TARGET"
}

setup_ssh_control() {
  SSH_CONTROL_DIR="$(mktemp -d)"
  SSH_CONTROL_PATH="${SSH_CONTROL_DIR}/cm-%r@%h:%p"
  trap cleanup EXIT INT TERM
}

cleanup() {
  if [ "${ENABLE_ROLLBACK_ARMED:-no}" = "yes" ] &&
     [ "${SSH_MASTER_STARTED:-no}" = "yes" ]; then
    rollback_enable >/dev/null 2>&1 || true
    ENABLE_ROLLBACK_ARMED="no"
  fi

  if [ "${SSH_MASTER_STARTED:-no}" = "yes" ] &&
     [ -n "${SSH_CONTROL_PATH:-}" ]; then
    ssh -S "$SSH_CONTROL_PATH" -O exit "$(ssh_target)" \
      >/dev/null 2>&1 || true
  fi

  SUDO_PASSWORD=""
  AUTH_PASSWORD=""

  [ -n "${ASKPASS_DIR:-}" ] &&
    rm -rf "$ASKPASS_DIR" || true

  [ -n "${SSH_CONTROL_DIR:-}" ] &&
    rm -rf "$SSH_CONTROL_DIR" || true
}

ssh_opts() {
  printf '%s\n' \
    -p "$SSH_PORT" \
    -o ConnectTimeout=8 \
    -o ServerAliveInterval=10 \
    -o ServerAliveCountMax=2 \
    -o StrictHostKeyChecking=accept-new \
    -o ControlMaster=auto \
    -o ControlPath="$SSH_CONTROL_PATH" \
    -o ControlPersist=10m
}

ssh_run() {
  # shellcheck disable=SC2046
  ssh $(ssh_opts) "$(ssh_target)" "$@"
}

read_auth_password_once() {
  local pw

  [ "${AUTH_PASSWORD_CAPTURED:-no}" = "yes" ] &&
    return 0

  has_tty ||
    die "SSH 认证需要密码，但当前会话无可用交互终端，无法获取认证信息。"

  printf '[AUTH] 请输入密码：' >/dev/tty

  stty -echo </dev/tty
  IFS= read -r pw </dev/tty || pw=""
  stty echo </dev/tty

  printf '\n' >/dev/tty

  [ -n "$pw" ] ||
    die "未输入密码，操作已终止"

  AUTH_PASSWORD="$pw"
  AUTH_PASSWORD_CAPTURED="yes"
}

start_ssh_master_with_password() {
  local rc=1 pwfd askpass

  read_auth_password_once

  if command -v sshpass >/dev/null 2>&1; then
    exec {pwfd}<<<"$AUTH_PASSWORD"

    # shellcheck disable=SC2046
    sshpass -d "$pwfd" ssh $(ssh_opts) \
      -o PreferredAuthentications=publickey,password,keyboard-interactive \
      -M -fN "$(ssh_target)" \
      >/dev/null 2>&1 &&
      rc=0 || rc=$?

    exec {pwfd}<&-

    return "$rc"
  fi

  ASKPASS_DIR="$(mktemp -d)"
  chmod 700 "$ASKPASS_DIR"

  askpass="${ASKPASS_DIR}/askpass.sh"

  cat >"$askpass" <<'EOF'
#!/bin/sh
printf '%s\n' "${BORROW_NET_ASKPASS_PASSWORD:-}"
EOF

  chmod 700 "$askpass"

  # shellcheck disable=SC2046
  DISPLAY=borrow-net \
  BORROW_NET_ASKPASS_PASSWORD="$AUTH_PASSWORD" \
  SSH_ASKPASS="$askpass" \
  SSH_ASKPASS_REQUIRE=force \
  ssh $(ssh_opts) \
    -o PreferredAuthentications=publickey,password,keyboard-interactive \
    -M -fN "$(ssh_target)" \
    </dev/null >/dev/null 2>&1 &&
    rc=0 || rc=$?

  rm -f "$askpass"
  rmdir "$ASKPASS_DIR" 2>/dev/null || true
  ASKPASS_DIR=""

  return "$rc"
}

start_ssh_master() {
  setup_ssh_control

  # shellcheck disable=SC2046
  if ssh $(ssh_opts) \
    -o BatchMode=yes \
    -M -fN "$(ssh_target)" \
    >/dev/null 2>&1; then

    SSH_MASTER_STARTED="yes"
    ok "SSH 连接成功"
    return 0
  fi

  if start_ssh_master_with_password; then
    SSH_MASTER_STARTED="yes"
    ok "SSH 连接成功"
  else
    AUTH_PASSWORD=""
    die "SSH 连接失败，请检查主机地址、端口、用户名、密码及 SSH 服务状态"
  fi
}

find_local_ip() {
  if [ -n "$LOCAL_IP_OVERRIDE" ]; then
    printf '%s\n' "$LOCAL_IP_OVERRIDE"
  else
    ip route get "$TARGET" 2>/dev/null |
      awk '{
        for (i=1; i<=NF; i++) {
          if ($i == "src") {
            print $(i+1)
            exit
          }
        }
      }'
  fi
}

is_loopback_or_any() {
  case "$1" in
    127.*|localhost|0.0.0.0|::1|'[::1]'|::|'[::]')
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

normalize_proxy_url() {
  local raw="$1" scheme host port

  raw="${raw%/}"

  if [[ "$raw" =~ ^([a-zA-Z][a-zA-Z0-9+.-]*)://([^/@]+@)?\[?([^]/:@]+)\]?:([0-9]+) ]]; then
    scheme="${BASH_REMATCH[1],,}"
    host="${BASH_REMATCH[3]}"
    port="${BASH_REMATCH[4]}"

  elif [[ "$raw" =~ ^([0-9]+)$ ]]; then
    scheme="${PROXY_SCHEME_MANUAL,,}"
    host="127.0.0.1"
    port="${BASH_REMATCH[1]}"

  elif [[ "$raw" =~ ^([^/:]+):([0-9]+)$ ]]; then
    scheme="${PROXY_SCHEME_MANUAL,,}"
    host="${BASH_REMATCH[1]}"
    port="${BASH_REMATCH[2]}"

  else
    return 1
  fi

  case "$scheme" in
    http|https)
      ;;
    socks|socks5|socks5h)
      scheme="socks5h"
      ;;
    *)
      return 1
      ;;
  esac

  printf '%s://%s:%s\n' "$scheme" "$host" "$port"
}

proxy_scheme() {
  printf '%s\n' "$1" |
    sed -E 's#^([a-zA-Z0-9+.-]+)://.*#\1#'
}

proxy_host() {
  printf '%s\n' "$1" |
    sed -E 's#^[a-zA-Z0-9+.-]+://([^:/]+):[0-9]+$#\1#'
}

proxy_port() {
  printf '%s\n' "$1" |
    sed -E 's#^.*:([0-9]+)$#\1#'
}

remote_proxy_url() {
  local url="$1" scheme host port

  scheme="$(proxy_scheme "$url")"
  host="$(proxy_host "$url")"
  port="$(proxy_port "$url")"

  if is_loopback_or_any "$host"; then
    host="$LOCAL_IP"
  fi

  printf '%s://%s:%s\n' "$scheme" "$host" "$port"
}

add_candidate() {
  local url="$1" source="$2" normalized item

  normalized="$(normalize_proxy_url "$url" 2>/dev/null || true)"

  [ -n "$normalized" ] || return 0

  for item in "${CANDIDATES[@]:-}"; do
    [ "${item%%|*}" = "$normalized" ] &&
      return 0
  done

  CANDIDATES+=("${normalized}|${source}")
}

collect_candidates() {
  CANDIDATES=()

  if [ -n "$PROXY_URL_MANUAL" ]; then
    add_candidate "$PROXY_URL_MANUAL" "手动指定"
    return
  fi

  if [ -n "$PROXY_PORT_MANUAL" ]; then
    add_candidate \
      "127.0.0.1:${PROXY_PORT_MANUAL}" \
      "手动端口"
    return
  fi

  local var value p

  for var in \
    HTTP_PROXY \
    HTTPS_PROXY \
    http_proxy \
    https_proxy \
    ALL_PROXY \
    all_proxy
  do
    value="${!var:-}"
    [ -n "$value" ] &&
      add_candidate "$value" "环境变量 ${var}"
  done

  for p in \
    7897 \
    7890 \
    7898 \
    7899 \
    10809 \
    1087 \
    8080 \
    8118 \
    20171 \
    20172 \
    6152
  do
    add_candidate \
      "http://127.0.0.1:${p}" \
      "常见 HTTP 端口"
  done

  for p in \
    7897 \
    7890 \
    7891 \
    1080 \
    10808 \
    20170 \
    20171 \
    6153
  do
    add_candidate \
      "socks5h://127.0.0.1:${p}" \
      "常见 SOCKS 端口"
  done
}

test_local_proxy() {
  local url="$1"

  curl \
    -fsS \
    --connect-timeout 2 \
    --max-time 8 \
    -x "$url" \
    "$TEST_URL" \
    >/dev/null 2>&1
}

test_remote_proxy() {
  local url="$1"

  ssh_run bash -s <<EOF >/dev/null 2>&1
set -euo pipefail

if command -v curl >/dev/null 2>&1; then
  curl \
    -fsS \
    --connect-timeout 3 \
    --max-time 12 \
    -x "$url" \
    "$TEST_URL" \
    >/dev/null

elif command -v python3 >/dev/null 2>&1; then
  python3 - <<PY
import urllib.request

proxy = "$url"

opener = urllib.request.build_opener(
    urllib.request.ProxyHandler(
        {
            "http": proxy,
            "https": proxy,
        }
    )
)

with opener.open("$TEST_URL", timeout=12) as r:
    r.read()
PY

else
  exit 1
fi
EOF
}

prepare_target() {
  [ -n "$TARGET" ] ||
    die "未指定目标主机地址。"

  [ -n "$SSH_USER" ] ||
    die "未指定 SSH 用户。请使用 -u/--user 指定。"

  [[ "$TARGET" =~ ^[A-Za-z0-9._:-]+$ ]] ||
    die "目标主机地址格式无效。"

  [[ "$SSH_USER" =~ ^[A-Za-z_][A-Za-z0-9._-]*\$?$ ]] ||
    die "SSH 用户名格式无效。"

  [[ "$SSH_PORT" =~ ^[0-9]+$ ]] &&
    [ "$SSH_PORT" -ge 1 ] &&
    [ "$SSH_PORT" -le 65535 ] ||
    die "SSH 端口必须为 1-65535 之间的整数。"

  LOCAL_IP="$(find_local_ip)"

  [ -n "$LOCAL_IP" ] ||
    die "无法自动确定访问 ${TARGET} 所使用的本机地址，请使用 -l/--local-ip 显式指定。"

  log "目标主机：$(ssh_target)"

  ping -c 1 -W 1 "$TARGET" \
    >/dev/null 2>&1 || true

  start_ssh_master
}

select_proxy() {
  collect_candidates

  [ "${#CANDIDATES[@]}" -gt 0 ] ||
    die "未检测到可用的本地代理候选。请使用 --proxy-url 或 -p/--proxy-port 显式指定。"

  local item local_url source remote_url

  for item in "${CANDIDATES[@]}"; do
    local_url="${item%%|*}"
    source="${item#*|}"

    if ! test_local_proxy "$local_url"; then
      continue
    fi

    remote_url="$(remote_proxy_url "$local_url")"

    if test_remote_proxy "$remote_url"; then
      SEL_LOCAL_URL="$local_url"
      SEL_REMOTE_URL="$remote_url"
      SEL_SCHEME="$(proxy_scheme "$local_url")"
      SEL_SOURCE="$source"

      ok "代理服务可用：${SEL_REMOTE_URL}"
      return 0
    fi
  done

  die "未找到目标主机可访问的代理服务。请确认代理已允许局域网访问（Allow LAN），或使用 --proxy-url 显式指定代理地址。"
}

remote_sudo_nopasswd() {
  ssh_run 'sudo -n true >/dev/null 2>&1'
}

remote_sudo_prime() {
  local reason="${1:-执行 root 操作}" pw

  if [ "${SUDO_PRIMED:-no}" = "yes" ]; then
    return 0
  fi

  if remote_sudo_nopasswd; then
    SUDO_PRIMED="yes"
    SUDO_PASSWORD=""
    return 0
  fi

  if [ "${AUTH_PASSWORD_CAPTURED:-no}" = "yes" ] &&
     [ -n "${AUTH_PASSWORD:-}" ]; then

    if printf '%s\n' "$AUTH_PASSWORD" |
      ssh_run 'sudo -S -p "" -v >/dev/null 2>&1'
    then
      SUDO_PASSWORD="$AUTH_PASSWORD"
      AUTH_PASSWORD=""
      SUDO_PRIMED="yes"
      return 0
    fi

    die "单次密码认证无法完成 sudo 验证。当前 SSH 密码与 sudo 密码可能不同；请统一认证密码，或配置 SSH 公钥认证后重新执行。"
  fi

  has_tty ||
    die "${reason} 需要目标主机 sudo 权限，但当前会话无可用交互终端，无法获取认证信息。"

  printf '[AUTH] 请输入 sudo 密码：' >/dev/tty

  stty -echo </dev/tty
  IFS= read -r pw </dev/tty || pw=""
  stty echo </dev/tty

  printf '\n' >/dev/tty

  if printf '%s\n' "$pw" |
    ssh_run 'sudo -S -p "" -v >/dev/null 2>&1'
  then
    SUDO_PASSWORD="$pw"
    SUDO_PRIMED="yes"
  else
    SUDO_PASSWORD=""
    die "sudo 认证失败。请确认用户 ${SSH_USER} 具有 sudo 权限，并检查所输入的密码。"
  fi
}

upload_remote_script() {
  local local_file="$1" remote_tmp

  remote_tmp="$(
    ssh_run \
      'mktemp /tmp/borrow-net-root.XXXXXX.sh'
  )"

  remote_tmp="${remote_tmp//$'\r'/}"
  remote_tmp="${remote_tmp//$'\n'/}"

  [ -n "$remote_tmp" ] ||
    die "无法在目标主机创建临时执行文件。"

  ssh_run \
    "cat > '$remote_tmp' && chmod 600 '$remote_tmp'" \
    < "$local_file"

  printf '%s\n' "$remote_tmp"
}

run_uploaded_remote_root_script() {
  local remote_tmp="$1" quoted cmd

  quoted="$(printf '%q' "$remote_tmp")"

  if [ -z "${SUDO_PASSWORD:-}" ]; then
    cmd="sudo -n bash $quoted; rc=\$?; rm -f $quoted; exit \$rc"
    ssh_run "$cmd"
  else
    cmd="sudo -S -p '' bash $quoted; rc=\$?; rm -f $quoted; exit \$rc"

    printf '%s\n' "$SUDO_PASSWORD" |
      ssh_run "$cmd"
  fi
}

run_remote_root_required() {
  local reason="$1" tmp remote_tmp

  tmp="$(mktemp)"
  cat > "$tmp"

  remote_sudo_prime "$reason"

  remote_tmp="$(upload_remote_script "$tmp")"
  rm -f "$tmp"

  run_uploaded_remote_root_script "$remote_tmp"
}

install_auto_clear() {
  run_remote_root_required "准备自动清理机制" <<EOF
set -euo pipefail

instance="borrow-net-auto-clear@${SSH_USER}.service"

if command -v systemctl >/dev/null 2>&1 &&
   [ -d /run/systemd/system ]; then
  systemctl stop "\$instance" \
    >/dev/null 2>&1 || true

  systemctl disable "\$instance" \
    >/dev/null 2>&1 || true
fi

if [ -x /usr/local/sbin/borrow-net-auto-clear ]; then
  /usr/local/sbin/borrow-net-auto-clear \
    clear-all "${SSH_USER}" \
    >/dev/null 2>&1 || true
fi
EOF

  run_remote_root_required "安装自动清理机制" <<'EOF'
set -euo pipefail

STATE_ROOT=/var/lib/borrow-net
APT_FILE=/etc/apt/apt.conf.d/95borrow-net
SELF=/usr/local/sbin/borrow-net-auto-clear
UNIT_TEMPLATE=/etc/systemd/system/borrow-net-auto-clear@.service

cat > "$SELF" <<'SH'
#!/usr/bin/env bash
set -euo pipefail

STATE_ROOT=/var/lib/borrow-net
APT_FILE=/etc/apt/apt.conf.d/95borrow-net
SELF=/usr/local/sbin/borrow-net-auto-clear
UNIT_TEMPLATE=/etc/systemd/system/borrow-net-auto-clear@.service

action="${1:-}"
user="${2:-}"
applied_arg="${3:-}"

[ -n "$action" ] || exit 2
[ -n "$user" ] || exit 2

home="$(
  getent passwd "$user" 2>/dev/null |
    awk -F: '{print $6}' ||
    true
)"

[ -n "$home" ] || exit 0

state="$STATE_ROOT/$user"
instance="borrow-net-auto-clear@${user}.service"

current_boot_id="$(
  cat /proc/sys/kernel/random/boot_id \
    2>/dev/null ||
    true
)"

as_user() {
  if command -v runuser >/dev/null 2>&1; then
    runuser \
      -u "$user" \
      -- env HOME="$home" \
      "$@"
  else
    return 127
  fi
}

state_applied_url() {
  if [ -f "$state/applied-url" ]; then
    cat "$state/applied-url"
  fi
}

cleanup_state_if_inactive() {
  [ -d "$state" ] || return 0

  if [ ! -e "$state/user.active" ] &&
     [ ! -e "$state/apt.active" ]; then
    rm -rf "$state"
  fi
}

save_git_key() {
  local key="$1" name="$2" values

  rm -f \
    "$state/$name.present" \
    "$state/$name.values"

  command -v git >/dev/null 2>&1 ||
    return 0

  if values="$(
    as_user git config \
      --global \
      --get-all "$key" \
      2>/dev/null
  )"; then
    : > "$state/$name.present"

    printf '%s\n' "$values" \
      > "$state/$name.values"
  fi
}

restore_git_key_if_owned() {
  local key="$1" name="$2"
  local applied current value

  command -v git >/dev/null 2>&1 ||
    return 0

  applied="$(state_applied_url)"

  [ -n "$applied" ] ||
    return 0

  current="$(
    as_user git config \
      --global \
      --get-all "$key" \
      2>/dev/null ||
      true
  )"

  [ "$current" = "$applied" ] ||
    return 0

  as_user git config \
    --global \
    --unset-all "$key" \
    >/dev/null 2>&1 || true

  if [ -e "$state/$name.present" ] &&
     [ -f "$state/$name.values" ]; then

    while IFS= read -r value ||
          [ -n "$value" ]; do

      as_user git config \
        --global \
        --add "$key" "$value" \
        >/dev/null 2>&1 || true

    done < "$state/$name.values"
  fi
}

npm_user_get() {
  local key="$1"

  if as_user npm config \
    get "$key" \
    --location=user \
    >/dev/null 2>&1
  then
    as_user npm config \
      get "$key" \
      --location=user \
      2>/dev/null
  else
    as_user npm config \
      get "$key" \
      2>/dev/null
  fi
}

npm_user_delete() {
  local key="$1"

  if as_user npm config \
    delete "$key" \
    --location=user \
    >/dev/null 2>&1
  then
    return 0
  fi

  as_user npm config \
    delete "$key" \
    >/dev/null 2>&1 || true
}

npm_user_set() {
  local key="$1" value="$2"

  if as_user npm config \
    set "$key" "$value" \
    --location=user \
    >/dev/null 2>&1
  then
    return 0
  fi

  as_user npm config \
    set "$key" "$value" \
    >/dev/null 2>&1 || true
}

save_npm_key() {
  local key="$1" name="$2" value

  rm -f \
    "$state/$name.present" \
    "$state/$name.value"

  command -v npm >/dev/null 2>&1 ||
    return 0

  value="$(
    npm_user_get "$key" ||
    true
  )"

  case "$value" in
    ""|null|undefined)
      return 0
      ;;
  esac

  : > "$state/$name.present"

  printf '%s\n' "$value" \
    > "$state/$name.value"
}

restore_npm_key_if_owned() {
  local key="$1" name="$2"
  local applied current value

  command -v npm >/dev/null 2>&1 ||
    return 0

  applied="$(state_applied_url)"

  [ -n "$applied" ] ||
    return 0

  current="$(
    npm_user_get "$key" ||
    true
  )"

  [ "$current" = "$applied" ] ||
    return 0

  npm_user_delete "$key"

  if [ -e "$state/$name.present" ] &&
     [ -f "$state/$name.value" ]; then

    value="$(cat "$state/$name.value")"
    npm_user_set "$key" "$value"
  fi
}

clear_user_state() {
  local rcname rc

  [ -e "$state/user.active" ] ||
    return 0

  if [ -f "$home/.config/borrow-net.env" ] &&
     grep -q \
       '^# Generated by borrow-net v' \
       "$home/.config/borrow-net.env" \
       2>/dev/null
  then

    if [ -e "$state/env.existed" ] &&
       [ -f "$state/borrow-net.env.backup" ]; then

      mkdir -p "$home/.config"

      cp -a \
        "$state/borrow-net.env.backup" \
        "$home/.config/borrow-net.env"

      chown "$user" \
        "$home/.config/borrow-net.env" \
        2>/dev/null || true
    else
      rm -f "$home/.config/borrow-net.env"
    fi
  fi

  for rcname in bashrc profile zshrc; do
    rc="$home/.$rcname"

    [ -f "$rc" ] ||
      continue

    sed -i \
      '/# >>> borrow-net >>>/,/# <<< borrow-net <<</d' \
      "$rc" ||
      true

    chown "$user" "$rc" \
      2>/dev/null || true

    if [ ! -s "$rc" ] &&
       [ ! -e "$state/rc-$rcname.existed" ]; then
      rm -f "$rc"
    fi
  done

  restore_git_key_if_owned \
    http.proxy \
    git-http

  restore_git_key_if_owned \
    https.proxy \
    git-https

  restore_npm_key_if_owned \
    proxy \
    npm-proxy

  restore_npm_key_if_owned \
    https-proxy \
    npm-https

  rm -f "$state/user.active"

  cleanup_state_if_inactive
}

prepare_user_state() {
  local applied="$1"
  local legacy_url=""
  local current rcname rc

  [ -n "$applied" ] ||
    exit 2

  clear_user_state || true

  mkdir -p "$state"
  chmod 700 "$STATE_ROOT" "$state"

  if [ -f "$home/.config/borrow-net.env" ] &&
     grep -q \
       '^# Generated by borrow-net v' \
       "$home/.config/borrow-net.env" \
       2>/dev/null
  then

    legacy_url="$(
      sed -n \
        's/^export ALL_PROXY=//p' \
        "$home/.config/borrow-net.env" |
        head -n1
    )"

    rm -f "$home/.config/borrow-net.env"
  fi

  rm -f \
    "$state/env.existed" \
    "$state/borrow-net.env.backup" \
    "$state/legacy-url"

  if [ -f "$home/.config/borrow-net.env" ]; then
    cp -a \
      "$home/.config/borrow-net.env" \
      "$state/borrow-net.env.backup"

    : > "$state/env.existed"
  fi

  if [ -n "$legacy_url" ]; then
    printf '%s\n' "$legacy_url" \
      > "$state/legacy-url"
  fi

  for rcname in bashrc profile zshrc; do
    rc="$home/.$rcname"

    rm -f "$state/rc-$rcname.existed"

    if [ -e "$rc" ]; then
      : > "$state/rc-$rcname.existed"

      sed -i \
        '/# >>> borrow-net >>>/,/# <<< borrow-net <<</d' \
        "$rc" \
        2>/dev/null || true

      chown "$user" "$rc" \
        2>/dev/null || true
    fi
  done

  if [ -n "$legacy_url" ]; then

    if command -v git >/dev/null 2>&1; then
      current="$(
        as_user git config \
          --global \
          --get-all http.proxy \
          2>/dev/null ||
          true
      )"

      if [ "$current" = "$legacy_url" ]; then
        as_user git config \
          --global \
          --unset-all http.proxy \
          >/dev/null 2>&1 || true
      fi

      current="$(
        as_user git config \
          --global \
          --get-all https.proxy \
          2>/dev/null ||
          true
      )"

      if [ "$current" = "$legacy_url" ]; then
        as_user git config \
          --global \
          --unset-all https.proxy \
          >/dev/null 2>&1 || true
      fi
    fi

    if command -v npm >/dev/null 2>&1; then
      current="$(
        npm_user_get proxy ||
        true
      )"

      [ "$current" = "$legacy_url" ] &&
        npm_user_delete proxy

      current="$(
        npm_user_get https-proxy ||
        true
      )"

      [ "$current" = "$legacy_url" ] &&
        npm_user_delete https-proxy
    fi
  fi

  save_git_key \
    http.proxy \
    git-http

  save_git_key \
    https.proxy \
    git-https

  save_npm_key \
    proxy \
    npm-proxy

  save_npm_key \
    https-proxy \
    npm-https

  printf '%s\n' "$applied" \
    > "$state/applied-url"

  printf '%s\n' "$current_boot_id" \
    > "$state/boot-id"

  : > "$state/user.active"
}

clear_apt_state() {
  [ -e "$state/apt.active" ] ||
    return 0

  if [ -f "$APT_FILE" ] &&
     grep -q \
       'Generated by borrow-net' \
       "$APT_FILE" \
       2>/dev/null
  then

    if [ -e "$state/apt.existed" ] &&
       [ -f "$state/apt.backup" ]; then

      cp -a \
        "$state/apt.backup" \
        "$APT_FILE"
    else
      rm -f "$APT_FILE"
    fi
  fi

  rm -f "$state/apt.active"

  cleanup_state_if_inactive
}

prepare_apt_state() {
  local applied="$1"
  local legacy_url=""

  [ -n "$applied" ] ||
    exit 2

  clear_apt_state || true

  mkdir -p "$state"
  chmod 700 "$STATE_ROOT" "$state"

  rm -f \
    "$state/apt.existed" \
    "$state/apt.backup"

  if [ -f "$state/legacy-url" ]; then
    legacy_url="$(cat "$state/legacy-url")"
  fi

  if [ -e "$APT_FILE" ]; then

    if grep -q \
         'Generated by borrow-net' \
         "$APT_FILE" \
         2>/dev/null ||
       {
         [ -n "$legacy_url" ] &&
         grep -qF \
           "$legacy_url" \
           "$APT_FILE" \
           2>/dev/null
       }
    then
      rm -f "$APT_FILE"
    else
      cp -a \
        "$APT_FILE" \
        "$state/apt.backup"

      : > "$state/apt.existed"
    fi
  fi

  printf '%s\n' "$applied" \
    > "$state/applied-url"

  if [ ! -f "$state/boot-id" ]; then
    printf '%s\n' "$current_boot_id" \
      > "$state/boot-id"
  fi

  : > "$state/apt.active"
}

clear_all() {
  clear_user_state || true
  clear_apt_state || true
  cleanup_state_if_inactive
}

remove_instance_artifacts() {
  find /etc/systemd/system \
    -type l \
    -name "$instance" \
    -delete \
    2>/dev/null || true

  if [ -d "$STATE_ROOT" ] &&
     ! find "$STATE_ROOT" \
       -mindepth 1 \
       -maxdepth 1 \
       -print \
       -quit |
       grep -q .
  then
    rmdir "$STATE_ROOT" \
      2>/dev/null || true
  fi

  if [ ! -d "$STATE_ROOT" ] &&
     ! find /etc/systemd/system \
       -type l \
       -name 'borrow-net-auto-clear@*.service' \
       -print \
       -quit \
       2>/dev/null |
       grep -q .
  then
    rm -f "$UNIT_TEMPLATE"
    rm -f "$SELF"
  fi
}

clear_and_uninstall() {
  clear_all
  remove_instance_artifacts
}

watch_lifecycle() {
  local saved_boot_id=""
  local child_pid=""

  if [ ! -e "$state/user.active" ] &&
     [ ! -e "$state/apt.active" ]; then

    clear_and_uninstall
    exit 0
  fi

  if [ -f "$state/boot-id" ]; then
    saved_boot_id="$(cat "$state/boot-id")"
  fi

  if [ -z "$saved_boot_id" ] ||
     [ "$saved_boot_id" != "$current_boot_id" ]; then

    clear_and_uninstall
    exit 0
  fi

  on_stop() {
    trap - TERM INT HUP

    if [ -n "$child_pid" ]; then
      kill "$child_pid" \
        >/dev/null 2>&1 || true

      wait "$child_pid" \
        >/dev/null 2>&1 || true

      child_pid=""
    fi

    clear_and_uninstall || true
    exit 0
  }

  trap on_stop TERM INT HUP

  while :; do
    sleep 86400 &
    child_pid=$!

    wait "$child_pid" ||
      true

    child_pid=""
  done
}

case "$action" in
  prepare-user)
    prepare_user_state "$applied_arg"
    ;;

  prepare-apt)
    prepare_apt_state "$applied_arg"
    ;;

  clear-user)
    clear_user_state
    ;;

  clear-apt)
    clear_apt_state
    ;;

  clear-all)
    clear_all
    ;;

  clear-and-uninstall)
    clear_and_uninstall
    ;;

  watch)
    watch_lifecycle
    ;;

  *)
    exit 2
    ;;
esac
