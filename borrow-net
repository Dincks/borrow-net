enable_flow() {
  step "启用代理"

  prepare_target
  sync_target_time
  select_proxy

  ENABLE_ROLLBACK_ARMED="yes"

  install_auto_clear

  write_user_proxy
  ok "用户代理已应用"

  APT_HANDLED="no"

  write_apt_proxy

  if [ "$APT_HANDLED" = "yes" ]; then
    ok "APT 代理已应用"
  fi

  remote_online_tests

  ENABLE_ROLLBACK_ARMED="no"

  echo
  ok "代理已启用"
}

clear_flow() {
  step "清除代理"

  prepare_target

  clear_all_proxy_and_uninstall

  echo
  ok "代理配置及 borrow-net 组件已清除"
}

menu_enable() {
  TARGET="$(
    read_required_tty \
      "请输入目标主机 IP"
  )"

  SSH_USER="$(
    read_required_tty \
      "请输入 SSH 用户名"
  )"

  SSH_PORT="$(
    read_tty \
      "请输入 SSH 端口" \
      "$SSH_PORT"
  )"

  if ask_yes_no \
    "是否配置 APT 代理" \
    "Y"
  then
    APT_MODE="yes"
  else
    APT_MODE="no"
  fi

  enable_flow
}

menu_clear() {
  TARGET="$(
    read_required_tty \
      "请输入目标主机 IP"
  )"

  SSH_USER="$(
    read_required_tty \
      "请输入 SSH 用户名"
  )"

  SSH_PORT="$(
    read_tty \
      "请输入 SSH 端口" \
      "$SSH_PORT"
  )"

  APT_MODE="yes"

  clear_flow
}

menu() {
  has_tty ||
    die "当前会话无可用交互终端，请使用命令行参数模式执行。"

  cat >/dev/tty <<MENU

borrow-net v${VERSION}

请选择操作：
  1) 启用代理
  2) 清除代理
  0) 退出

MENU

  local choice

  choice="$(
    read_tty \
      "请选择" \
      "1"
  )"

  case "$choice" in
    1)
      menu_enable
      exit 0
      ;;

    2)
      menu_clear
      exit 0
      ;;

    0|3|q|Q|exit)
      exit 0
      ;;

    *)
      die "无效的操作选项。"
      ;;
  esac
}

parse_args() {
  case "${1:-menu}" in

    menu|wizard)
      MODE="menu"
      shift || true
      ;;

    enable)
      MODE="enable"
      shift

      TARGET="${1:-}"

      if [ $# -gt 0 ]; then
        shift
      fi
      ;;

    clear)
      MODE="clear"
      shift

      TARGET="${1:-}"

      if [ $# -gt 0 ]; then
        shift
      fi
      ;;

    -h|--help|help)
      usage
      exit 0
      ;;

    *)
      usage
      exit 1
      ;;
  esac

  while [ $# -gt 0 ]; do
    case "$1" in

      -u|--user)
        SSH_USER="$2"
        shift 2
        ;;

      -P|--ssh-port)
        SSH_PORT="$2"
        shift 2
        ;;

      --proxy-url)
        PROXY_URL_MANUAL="$2"
        shift 2
        ;;

      -p|--proxy-port)
        PROXY_PORT_MANUAL="$2"
        shift 2
        ;;

      --proxy-scheme)
        PROXY_SCHEME_MANUAL="$2"
        shift 2
        ;;

      -l|--local-ip)
        LOCAL_IP_OVERRIDE="$2"
        shift 2
        ;;

      --with-apt|--with-sudo)
        APT_MODE="yes"
        shift
        ;;

      --no-apt|--skip-sudo)
        APT_MODE="no"
        shift
        ;;

      --sync-time)
        SYNC_TIME_MODE="yes"
        shift
        ;;

      --no-sync-time)
        SYNC_TIME_MODE="no"
        shift
        ;;

      -h|--help)
        usage
        exit 0
        ;;

      *)
        die "无法识别的命令行参数：$1"
        ;;
    esac
  done
}

main() {
  need ip
  need awk
  need ssh
  need sed
  need curl

  parse_args "$@"

  case "$MODE" in
    menu)
      menu
      ;;

    enable)
      enable_flow
      ;;

    clear)
      clear_flow
      ;;
  esac
}

main "$@"
