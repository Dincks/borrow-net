sync_target_time() {
  case "$SYNC_TIME_MODE" in
    no)
      return 0
      ;;

    auto|yes)
      ;;

    *)
      die "无效的时间同步模式。SYNC_TIME_MODE 仅支持 auto、yes 或 no。"
      ;;
  esac

  local local_epoch remote_epoch diff absdiff

  local_epoch="$(date -u +%s)"

  remote_epoch="$(
    ssh_run date -u +%s \
      2>/dev/null ||
      printf '0'
  )"

  remote_epoch="${remote_epoch//$'\r'/}"
  remote_epoch="${remote_epoch//$'\n'/}"

  if ! [[ "$remote_epoch" =~ ^[0-9]+$ ]]; then
    remote_epoch=0
  fi

  diff=$((local_epoch - remote_epoch))

  if [ "$diff" -lt 0 ]; then
    absdiff=$((-diff))
  else
    absdiff="$diff"
  fi

  if [ "$SYNC_TIME_MODE" = "auto" ]; then
    if [ "$absdiff" -gt 300 ]; then
      warn "目标主机时间偏差超过 5 分钟，可能影响 HTTPS 访问；如需同步请使用 --sync-time。"
    fi

    return 0
  fi

  run_remote_root_required "同步目标主机时间" <<EOF
set -euo pipefail

date -u -s '@${local_epoch}' \
  >/dev/null

if command -v timedatectl >/dev/null 2>&1; then
  timedatectl set-ntp true \
    >/dev/null 2>&1 || true
fi
EOF

  ok "目标主机时间已同步"
}

run_remote_root() {
  local tmp remote_tmp

  tmp="$(mktemp)"
  cat > "$tmp"

  case "$APT_MODE" in
    no)
      rm -f "$tmp"
      return 0
      ;;

    yes|ask)
      ;;

    *)
      rm -f "$tmp"
      die "无效的 APT 处理模式。APT_MODE 仅支持 ask、yes 或 no。"
      ;;
  esac

  if [ "${SEL_SCHEME:-http}" = "socks5h" ]; then
    log "SOCKS 模式下不配置 APT 代理"
    rm -f "$tmp"
    return 0
  fi

  if [ "$APT_MODE" = "ask" ]; then
    if ! ask_yes_no \
      "是否同时处理 APT 系统级代理配置？该操作需要 sudo 权限" \
      "Y"
    then
      rm -f "$tmp"
      return 0
    fi
  fi

  remote_sudo_prime "apt 代理配置"

  remote_tmp="$(upload_remote_script "$tmp")"
  rm -f "$tmp"

  run_uploaded_remote_root_script "$remote_tmp"

  APT_HANDLED="yes"
}

